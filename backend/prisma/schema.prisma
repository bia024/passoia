// Conexão com o banco SQLite
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cliente do Prisma
generator client {
  provider = "prisma-client-js"
}

// Modelo dos usuários
model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  wishlist WishlistItem[]
}

model Produto {
  id          String   @id @default(uuid())
  nome        String
  descricao   String
  preco       Float
  imagemUrl   String // Imagem principal
  avaliacoes  String // URL para a imagem de avaliações
  thumbnails  ProdutoThumbnail[]
  cores       ProdutoCor[]

  wishlistedBy WishlistItem[]
}

model ProdutoThumbnail {
  id        String  @id @default(uuid())
  url       String
  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String
}

model WishlistItem {
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  produto   Produto  @relation(fields: [produtoId], references: [id])
  produtoId String
  addedAt   DateTime @default(now())

  @@id([userId, produtoId]) // Chave primária composta
}

model ProdutoCor {
  id        String  @id @default(uuid())
  hex       String // Ex: "#BFB8E8"
  nome      String // Ex: "lavender"
  imagemUrl String // Imagem associada à cor
  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String
}
