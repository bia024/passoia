datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  tipo        String   // consumidor | panelista | parceiro | admin
  nome        String?
  cpf         String?  @unique
  nomeEmpresa String?
  cnpj        String?  @unique
  email       String   @unique
  senha       String
  cep         String?
  telefone    String?
  endereco    String?
  bairro      String?
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now())

  Wishlist WishlistItem[]
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  preco      Float
  estoque    Int      @default(0)
  imagemUrl  String?
  criadoEm   DateTime @default(now())

  Wishlist WishlistItem[]
}

model WishlistItem {
  userId    Int
  produtoId Int
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([userId, produtoId])
}
